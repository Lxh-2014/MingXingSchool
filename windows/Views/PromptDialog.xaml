<Window x:Class="MingxingSchool.Desktop.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False"
        Background="Transparent" PreviewKeyDown="Window_PreviewKeyDown"
        FontFamily="{DynamicResource UiFont}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Border Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="24" Margin="16"
            Effect="{StaticResource CardShadowEffect}">
        <Grid>
            <!-- 自绘关闭按钮（右上角），替代系统标题栏 -->
            <Button Style="{StaticResource CaptionCloseButton}" Width="30" Height="26" Content="&#xE8BB;"
                    ToolTip="关闭" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Click="Close_Click" />

            <StackPanel>
                <!-- 标题：按住可拖动窗口 -->
                <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitleText}" FontSize="16"
                           MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />
                <TextBlock x:Name="MessageText" Style="{StaticResource MutedText}" Margin="0,8,0,14" />
                <TextBox x:Name="InputBox" MinHeight="38" />
                <PasswordBox x:Name="PasswordInput" MinHeight="38" Visibility="Collapsed" />
                <TextBox x:Name="MultiInput" Visibility="Collapsed" AcceptsReturn="True" TextWrapping="Wrap"
                         Height="140" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="取消" Style="{StaticResource GrayButton}" Padding="18,8" Click="Cancel_Click" />
                    <Button x:Name="OkButton" Content="确定" Style="{StaticResource PrimaryButton}" Padding="18,8"
                            Margin="10,0,0,0" IsDefault="True" Click="Ok_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
