<UserControl x:Class="MingxingSchool.Desktop.Views.Pages.ShopPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 商店内部视图切换标签（对齐网页端 .sp-tab：胶囊描边，选中主色实底白字） -->
        <Style x:Key="SpTab" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="999" Padding="22,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分类筛选胶囊（对齐网页端 .sp-chip：描边小胶囊，选中主色实底白字） -->
        <Style x:Key="SpChip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="999" Padding="16,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 小图标按钮（加入购物车 / 返回）：28x28 透明底，悬停浅灰圆角 4（对齐 docs/图标按钮.html） -->
        <Style x:Key="SpIconButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                              TextElement.FontSize="14" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Emoji 图标（WPF 不支持彩色字体，统一用主色着色，避免出现黑色实心块） -->
        <Style x:Key="SpEmoji" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Emoji" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 数量步进器按钮（对齐网页端 .step-btn：26x26 圆角 8 描边） -->
        <Style x:Key="SpStepButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                              TextElement.FontSize="14" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 商店内部导航（与网页端商店侧边栏入口一致：逛店 / 购物车 / 我的订单 / 我的店铺） -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <RadioButton x:Name="TabHome" Style="{StaticResource SpTab}" Tag="home" Content="逛店"
                         IsChecked="True" GroupName="ShopNav" Checked="ShopTab_Checked" />
            <RadioButton x:Name="TabCart" Style="{StaticResource SpTab}" Tag="cart"
                         GroupName="ShopNav" Checked="ShopTab_Checked" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="购物车" VerticalAlignment="Center" />
                    <Border x:Name="CartBadge" Background="{DynamicResource DangerBrush}" CornerRadius="7"
                            Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="CartBadgeText" Text="0" FontSize="10" Foreground="White" />
                    </Border>
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="TabOrders" Style="{StaticResource SpTab}" Tag="orders" Content="我的订单"
                         GroupName="ShopNav" Checked="ShopTab_Checked" Margin="8,0,0,0" />
            <RadioButton x:Name="TabMyShops" Style="{StaticResource SpTab}" Tag="myshops" Content="我的店铺"
                         GroupName="ShopNav" Checked="ShopTab_Checked" Margin="8,0,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <!-- ============ 视图：逛店（搜索 + 分类 chips + 店铺网格） ============ -->
            <Grid x:Name="HomeView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 搜索框：白底描边圆角 14，左侧放大镜 -->
                <Border Grid.Row="0" Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="16,10" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Grid Grid.Column="1" Margin="10,0,0,0">
                            <TextBox x:Name="HomeSearch" BorderThickness="0" Background="Transparent"
                                     FontSize="15" VerticalAlignment="Center" MaxLength="50"
                                     TextChanged="HomeSearch_TextChanged" />
                            <TextBlock Text="搜索店铺或商品" IsHitTestVisible="False" VerticalAlignment="Center"
                                       FontSize="15" Foreground="{DynamicResource InputPlaceholderBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=HomeSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <DockPanel Grid.Row="1">
                    <WrapPanel x:Name="HomeChips" DockPanel.Dock="Top" Margin="0,0,0,14" />

                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ShopGrid">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 店铺卡片（对齐网页端 .shop-card：白底描边圆角 16，封面 120 高） -->
                                        <Border Width="240" Margin="0,0,16,16" Background="{DynamicResource CardBrush}"
                                                BorderThickness="1" CornerRadius="16" Cursor="Hand"
                                                MouseLeftButtonDown="ShopCard_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3"
                                                                                      Direction="270" Opacity="0.12" Color="#000000" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <Border Height="120" CornerRadius="16,16,0,0" Background="{DynamicResource PrimarySoftBrush}">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Emoji}" FontSize="48" Style="{StaticResource SpEmoji}" />
                                                        <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Margin="16,14,16,16">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <Border Background="#FFEEEE" CornerRadius="9" Padding="8,2"
                                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding StatusVisible}">
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#C40000" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="13"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="999" Padding="10,2">
                                                            <TextBlock Text="{Binding Category}" FontSize="12"
                                                                       Foreground="{DynamicResource PrimaryBrush}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding ProductCountText}" FontSize="12"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="HomeEmpty" Text="没有找到匹配的店铺，换个关键词试试～"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                                   Margin="0,40,0,0" Visibility="Collapsed" />
                    </Grid>
                </DockPanel>
            </Grid>

            <!-- ============ 视图：店铺详情（店铺头 + 分类 chips + 商品网格） ============ -->
            <Grid x:Name="ShopView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <Button Content="&#xE72B;" Style="{StaticResource SpIconButton}" HorizontalAlignment="Left"
                            ToolTip="返回逛店" Click="BackToHome_Click" Margin="0,0,0,8" />

                    <!-- 店铺信息条（对齐网页端 .sp-shop-head：84 封面 + 名称/简介/分类） -->
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="20">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="84" Height="84" CornerRadius="16" Background="{DynamicResource PrimarySoftBrush}">
                                <Grid>
                                    <TextBlock x:Name="ShopHeadEmoji" FontSize="40" Style="{StaticResource SpEmoji}" />
                                    <Image x:Name="ShopHeadCover" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ShopHeadName" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="ShopHeadDesc" FontSize="13" Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                <Border x:Name="ShopHeadTag" Background="{DynamicResource PrimarySoftBrush}"
                                        CornerRadius="999" Padding="10,2" Margin="0,6,0,0" HorizontalAlignment="Left">
                                    <TextBlock x:Name="ShopHeadTagText" FontSize="12"
                                               Foreground="{DynamicResource PrimaryBrush}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <WrapPanel x:Name="ShopChips" Grid.Row="1" Margin="0,0,0,14" />

                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="GoodsGrid">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 商品卡片（对齐网页端 .goods-card：圆角 14、封面 120、价格 #E8590C） -->
                                    <Border Width="190" Margin="0,0,14,14" Padding="12"
                                            Background="{DynamicResource CardBrush}"
                                            BorderThickness="1" CornerRadius="14">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Border Height="120" CornerRadius="10" Background="{DynamicResource PrimarySoftBrush}">
                                                <Grid>
                                                    <TextBlock Text="{Binding Emoji}" FontSize="44" Style="{StaticResource SpEmoji}" />
                                                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <DockPanel Margin="0,8,0,0">
                                                <Button DockPanel.Dock="Right" Content="&#xE710;"
                                                        Style="{StaticResource SpIconButton}"
                                                        ToolTip="加入购物车" Click="AddToCart_Click" />
                                                <WrapPanel>
                                                    <TextBlock Text="{Binding PriceText}" FontSize="16" FontWeight="Bold"
                                                               Foreground="#E8590C" />
                                                    <TextBlock Text="{Binding SalesText}" FontSize="11" Margin="6,4,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </WrapPanel>
                                            </DockPanel>
                                            <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="999"
                                                    Padding="8,1" Margin="0,4,0,0" HorizontalAlignment="Left"
                                                    Visibility="{Binding BadgeVisible}">
                                                <TextBlock Text="{Binding BadgeText}" FontSize="11"
                                                           Foreground="{DynamicResource PrimaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="GoodsEmpty" Text="这家店暂时没有商品～" Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed" />
                </Grid>
            </Grid>

            <!-- ============ 视图：购物车（按店铺分组 + 备注 + 合计 + 提交订单） ============ -->
            <Grid x:Name="CartView" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="760">
                        <ItemsControl x:Name="CartGroups">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 店铺分组卡片（对齐网页端 .cart-group） -->
                                    <Border Background="{DynamicResource CardBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="14" Padding="14,14,18,14" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ShopName}" FontSize="14" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />
                                            <ItemsControl ItemsSource="{Binding Lines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                                                Padding="0,10">
                                                            <DockPanel>
                                                                <Border Width="52" Height="52" CornerRadius="10"
                                                                        Background="{DynamicResource PrimarySoftBrush}"
                                                                        DockPanel.Dock="Left">
                                                                    <Grid>
                                                                        <TextBlock Text="{Binding Emoji}" FontSize="24" Style="{StaticResource SpEmoji}" />
                                                                        <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                                                    </Grid>
                                                                </Border>

                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                                                                            VerticalAlignment="Center" Margin="12,0,0,0">
                                                                    <Button Content="&#xE738;" Style="{StaticResource SpStepButton}"
                                                                            Click="CartDec_Click" />
                                                                    <TextBlock Text="{Binding Quantity}" MinWidth="22"
                                                                               TextAlignment="Center" VerticalAlignment="Center"
                                                                               FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                    <Button Content="&#xE710;" Style="{StaticResource SpStepButton}"
                                                                            Click="CartInc_Click" />
                                                                </StackPanel>

                                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontSize="14"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding SpecText}" FontSize="12" Margin="0,3,0,0"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                                               Visibility="{Binding SpecVisible}" />
                                                                    <TextBlock Text="{Binding PriceText}" FontSize="13" Margin="0,3,0,0"
                                                                               Foreground="#E8590C" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 结算区：备注 + 合计 + 提交订单 -->
                        <Border x:Name="CartCheckout" Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="14" Padding="18" Margin="0,4,0,20">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="备注" Width="64" FontSize="14"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <Grid>
                                        <TextBox x:Name="CartNote" FontSize="14" MaxLength="100" Padding="9,8" />
                                        <TextBlock Text="选填，如：课间来取" IsHitTestVisible="False" Margin="11,0,0,0"
                                                   VerticalAlignment="Center" FontSize="14"
                                                   Foreground="{DynamicResource InputPlaceholderBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=CartNote}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DockPanel>
                                <DockPanel Margin="0,14,0,0">
                                    <Button Content="提交订单" Style="{StaticResource PrimaryButton}"
                                            DockPanel.Dock="Right" Click="SubmitOrder_Click" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="合计" FontSize="15"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="CartTotalText" Text="0 积分" FontSize="20" FontWeight="Bold"
                                                   Foreground="#E8590C" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="CartEmpty" Text="购物车空空如也，回逛店页看看吧～"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                                   Margin="0,40,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============ 视图：我的订单（订单卡片列表） ============ -->
            <Grid x:Name="OrdersView" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="760">
                        <ItemsControl x:Name="OrdersList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 订单卡片（对齐网页端 .order-card） -->
                                    <Border Background="{DynamicResource CardBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="14" Padding="16,18" Margin="0,0,0,14" Cursor="Hand"
                                            MouseLeftButtonDown="OrderCard_Click">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                    <Border x:Name="StatusBadgeBox" Background="#FFF4E5" CornerRadius="9"
                                                            Padding="8,2">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{Binding StatusBrush}" />
                                                    </Border>
                                                    <Border Background="#FFEEEE" CornerRadius="9" Padding="8,2" Margin="6,0,0,0"
                                                            Visibility="{Binding RefundVisible}">
                                                        <TextBlock Text="{Binding RefundText}" FontSize="12" Foreground="#C40000" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding IdText}" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </DockPanel>

                                            <DockPanel Margin="0,10,0,0">
                                                <Border Width="48" Height="48" CornerRadius="10" DockPanel.Dock="Left"
                                                        Background="{DynamicResource PrimarySoftBrush}">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Emoji}" FontSize="22" Style="{StaticResource SpEmoji}" />
                                                        <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <WrapPanel>
                                                        <TextBlock Text="{Binding FirstName}" FontSize="14"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding MoreText}" FontSize="12" Margin="8,2,0,0"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   Visibility="{Binding MoreVisible}" />
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding TimeText}" FontSize="12" Margin="0,4,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </DockPanel>

                                            <DockPanel Margin="0,12,0,0">
                                                <TextBlock Text="{Binding TotalText}" FontSize="16" FontWeight="Bold"
                                                           Foreground="#E8590C" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding CountText}" FontSize="13"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="OrdersEmpty" Text="还没有订单，回逛店页看看吧～"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                                   Margin="0,40,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============ 视图：订单详情（面板内容由代码动态生成） ============ -->
            <Grid x:Name="OrderDetailView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Content="&#xE72B;" Style="{StaticResource SpIconButton}"
                        HorizontalAlignment="Left" ToolTip="返回我的订单" Margin="0,0,0,8"
                        Click="BackToOrders_Click" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="OrderDetailHost" MaxWidth="760" />
                </ScrollViewer>
            </Grid>

            <!-- ============ 视图：我的店铺 ============ -->
            <Grid x:Name="MyShopsView" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="760">
                        <ItemsControl x:Name="MyShopList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 我的店铺卡片（对齐网页端 .myshop-card：52 封面 + 名称/简介 + 状态标签 + 管理商品） -->
                                    <Border Background="{DynamicResource CardBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="14" Padding="14,14,23,14" Margin="0,0,0,16">
                                        <DockPanel>
                                            <Border Width="52" Height="52" CornerRadius="12" DockPanel.Dock="Left"
                                                    Background="{DynamicResource PrimarySoftBrush}">
                                                <Grid>
                                                    <TextBlock Text="{Binding Emoji}" FontSize="26" Style="{StaticResource SpEmoji}" />
                                                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>

                                            <Button Content="管理商品" Style="{StaticResource PrimaryButton}"
                                                    DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                                                    Click="ManageShop_Click" />

                                            <!-- 营业状态徽标（胶囊）：点击可切换营业 / 休息 -->
                                            <Border DockPanel.Dock="Right" CornerRadius="999" Padding="9,3"
                                                    VerticalAlignment="Center" Cursor="Hand"
                                                    Background="{Binding StatusBackgroundBrush}"
                                                    MouseLeftButtonDown="ToggleShopStatus_Click">
                                                <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                           Foreground="{Binding StatusBrush}" />
                                            </Border>

                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="20"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Sub}" FontSize="13" Margin="0,4,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="MyShopsEmpty" Text="你还没有开店，可以到网页端开一家自己的店～"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                                   Margin="0,40,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
