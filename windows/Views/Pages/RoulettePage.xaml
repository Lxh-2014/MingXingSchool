<UserControl x:Class="MingxingSchool.Desktop.Views.Pages.RoulettePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MingxingSchool.Desktop.Controls">
    <UserControl.Resources>
        <!-- 右侧转盘列表项：与网页端 .wheel-picker-item 一致（圆角 8、悬停/选中浅灰底） -->
        <Style x:Key="PickerItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,12" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20" x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧：转盘 + 操作按钮 ==================== -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center">
                <!-- 转盘区域：460×460 容器，内部 420 转盘 + 顶部红色指针 -->
                <Grid Width="460" Height="460">
                    <controls:WheelView x:Name="Wheel" Width="420" Height="420"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:WheelView.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.22" />
                        </controls:WheelView.Effect>
                    </controls:WheelView>

                    <!-- 指针：顶部红色倒三角，带投影 -->
                    <Path Data="M0,0 L50,0 L25,50 Z" Fill="#FF4444" IsHitTestVisible="False"
                          HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0">
                        <Path.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="4" Direction="270" Opacity="0.4" />
                        </Path.Effect>
                    </Path>
                </Grid>

                <!-- 操作按钮：开始转动（整行）+ 打乱选项 / 独立页面（两列） -->
                <Grid Width="340" Margin="0,14,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="SpinButton" Grid.Row="0" Grid.ColumnSpan="3" Content="开始转动"
                            Style="{StaticResource PrimaryButton}" Height="48" FontSize="15"
                            HorizontalAlignment="Stretch" Click="Spin_Click" />

                    <Button Grid.Row="1" Grid.Column="0" Content="打乱选项" Style="{StaticResource GrayButton}"
                            Height="44" Margin="0,10,0,0" Click="Shuffle_Click" />
                    <Button Grid.Row="1" Grid.Column="2" Content="独立页面" Style="{StaticResource GrayButton}"
                            Height="44" Margin="0,10,0,0" Click="Standalone_Click" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== 右侧：转盘选择列 ==================== -->
        <Border Grid.Column="2" Background="{DynamicResource CardBrush}" CornerRadius="12"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16">
            <DockPanel>
                <!-- 底部：新建转盘 -->
                <Button DockPanel.Dock="Bottom" Content="＋ 新建转盘" Style="{StaticResource PrimaryButton}"
                        Height="42" FontSize="13" HorizontalAlignment="Stretch" Margin="0,10,0,0"
                        Click="Create_Click" />

                <!-- 顶部：搜索框（放大镜在右侧） -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBox x:Name="SearchBox" Height="36" Padding="10,0,34,0"
                             VerticalContentAlignment="Center" TextChanged="Search_TextChanged" />
                    <Path IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="0,0,10,0" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="2"
                          Data="M 9,0 A 9,9 0 1 0 9.01,0 M 15.5,15.5 L 23,23"
                          Width="20" Height="20" Stretch="Uniform" />
                    <TextBlock Text="搜索" IsHitTestVisible="False" Margin="12,0,0,0"
                               VerticalAlignment="Center" FontSize="14"
                               Foreground="{DynamicResource InputPlaceholderBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- 转盘列表 -->
                <Grid>
                    <ListBox x:Name="WheelList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource PickerItemStyle}"
                             SelectionChanged="WheelList_SelectionChanged">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="编辑选项" Click="Edit_Click" />
                                <MenuItem Header="删除转盘" Click="Delete_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <TextBlock x:Name="EmptyText" Text="暂无转盘" HorizontalAlignment="Center"
                               VerticalAlignment="Top" Margin="0,20,0,0" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- ==================== 独立页面：全屏遮罩 + 大转盘 ==================== -->
        <Grid x:Name="StandaloneOverlay" Grid.ColumnSpan="3" Background="#B3000000"
              Visibility="Collapsed">
            <Border Width="620" Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Effect="{StaticResource CardShadowEffect}">
                <Grid>
                    <!-- 自绘关闭按钮 -->
                    <Button Style="{StaticResource CaptionCloseButton}" Width="30" Height="26"
                            Content="&#xE8BB;" ToolTip="返回" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Click="CloseStandalone_Click" />

                    <StackPanel>
                        <TextBlock x:Name="StandaloneTitle" Style="{StaticResource CardTitleText}"
                                   HorizontalAlignment="Center" Margin="0,0,0,10" />

                        <Grid Width="520" Height="520" HorizontalAlignment="Center">
                            <controls:WheelView x:Name="StandaloneWheel" Width="460" Height="460"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                <controls:WheelView.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.22" />
                                </controls:WheelView.Effect>
                            </controls:WheelView>
                            <Path Data="M0,0 L50,0 L25,50 Z" Fill="#FF4444" IsHitTestVisible="False"
                                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0">
                                <Path.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="4" Direction="270" Opacity="0.4" />
                                </Path.Effect>
                            </Path>
                        </Grid>

                        <Button x:Name="StandaloneSpinButton" Content="开始转动"
                                Style="{StaticResource PrimaryButton}" Width="260" Height="46"
                                HorizontalAlignment="Center" Margin="0,14,0,0" Click="StandaloneSpin_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
