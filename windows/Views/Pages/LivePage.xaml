<UserControl x:Class="MingxingSchool.Desktop.Views.Pages.LivePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <!-- 频道切换胶囊（对齐平台描边胶囊风格，选中主色实底白字） -->
        <Style x:Key="LiveChannelTab" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="18,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 角色切换胶囊（主播端 / 观看端）：比频道胶囊更紧凑，视觉保持一致 -->
        <Style x:Key="LiveRoleTab" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="9" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 原生卡片内的分区标题 -->
        <Style x:Key="LiveSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleText}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部：页面标题 + 当前角色 + 频道切换 + 画面操作 + 刷新 -->
        <DockPanel x:Name="HeaderBar" Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="明星直播" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource TextTitleBrush}" />
                <TextBlock x:Name="RoleText" Text="正在加载…" FontSize="12.5" Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <!-- 角色切换：管理员可在「主播端」与「观看端」之间切换，普通用户固定观看端 -->
                <StackPanel x:Name="RoleSwitch" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,16,0">
                    <RadioButton x:Name="RoleHost" Content="主播端" Tag="host"
                                 GroupName="LiveRole" Style="{StaticResource LiveRoleTab}"
                                 Checked="Role_Checked" ToolTip="开播 / 推流" />
                    <RadioButton x:Name="RoleViewer" Content="观看端" Tag="viewer" IsChecked="True"
                                 GroupName="LiveRole" Style="{StaticResource LiveRoleTab}"
                                 Checked="Role_Checked" ToolTip="观看直播" />
                </StackPanel>

                <TextBlock Text="频道" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <RadioButton x:Name="Channel1" Content="1" Tag="ch1" IsChecked="True"
                             GroupName="LiveChannel" Style="{StaticResource LiveChannelTab}"
                             Checked="Channel_Checked" ToolTip="频道 1" />
                <RadioButton x:Name="Channel2" Content="2" Tag="ch2"
                             GroupName="LiveChannel" Style="{StaticResource LiveChannelTab}"
                             Checked="Channel_Checked" ToolTip="频道 2" />
                <RadioButton x:Name="Channel3" Content="3" Tag="ch3"
                             GroupName="LiveChannel" Style="{StaticResource LiveChannelTab}"
                             Checked="Channel_Checked" ToolTip="频道 3" />
                <RadioButton x:Name="Channel4" Content="4" Tag="ch4"
                             GroupName="LiveChannel" Style="{StaticResource LiveChannelTab}"
                             Checked="Channel_Checked" ToolTip="频道 4" />

                <!-- 画面操作：全屏、镜像、填充（镜像与填充仅主播端显示） -->
                <Button x:Name="FullscreenButton" Content="全屏" Style="{StaticResource SmallGrayButton}"
                        Margin="12,0,0,0" Click="Fullscreen_Click" ToolTip="放大画面区域" />
                <Button x:Name="MirrorButton" Content="镜像" Style="{StaticResource SmallGrayButton}"
                        Margin="8,0,0,0" Click="Mirror_Click" ToolTip="本地预览左右镜像" />
                <Button x:Name="FitButton" Content="铺满" Style="{StaticResource SmallGrayButton}"
                        Margin="8,0,0,0" Click="Fit_Click" ToolTip="切换画面填充方式" />
                <Button x:Name="RefreshButton" Content="刷新" Style="{StaticResource SmallGrayButton}"
                        Margin="8,0,0,0" Click="Refresh_Click" ToolTip="重新加载直播画面" />
            </StackPanel>
        </DockPanel>

        <!-- 内容：左侧/整屏为直播画面（WebView2 只承载画面），主播端右侧为原生控制面板 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="HostPanelColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border x:Name="VideoBorder" CornerRadius="14" ClipToBounds="True"
                    Background="Black"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <wv2:WebView2 x:Name="Web" Visibility="Collapsed" />

                    <!-- 原生占位层：画面就绪前显示，避免空白与白屏 -->
                    <Border x:Name="Placeholder" Background="Black">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="PlaceholderTitle" Text="等待直播画面" FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="#FFFFFF" />
                            <TextBlock x:Name="PlaceholderText" Text="正在连接频道…" FontSize="12.5" Margin="0,8,0,0"
                                       HorizontalAlignment="Center" Foreground="#A0A4AB" />
                        </StackPanel>
                    </Border>

                    <!-- 加载遮罩：首帧渲染前避免白屏 -->
                    <Border x:Name="LoadingMask" Background="{DynamicResource CardBrush}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="正在加载直播画面…" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextTitleBrush}" />
                            <TextBlock x:Name="LoadingHint" Text="首次加载需要几秒钟" FontSize="12.5"
                                       Margin="0,8,0,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= 主播端原生控制面板 ================= -->
            <ScrollViewer x:Name="HostPanel" Grid.Column="1" Margin="14,0,0,0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
                <StackPanel>
                    <!-- 直播控制 -->
                    <Border Style="{StaticResource FlatCardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="直播控制" Style="{StaticResource LiveSectionTitle}" />
                            <Button x:Name="LiveButton" Content="下播" Style="{StaticResource DangerButton}"
                                    Padding="14,7" HorizontalAlignment="Stretch" Click="Live_Click"
                                    ToolTip="开始 / 停止向观众直播" />
                            <TextBlock Text="音源" Style="{StaticResource FieldLabelText}" Margin="0,14,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="SourceMic" Content="本机麦克风" Tag="local" IsChecked="True"
                                             GroupName="LiveSource" Style="{StaticResource LiveRoleTab}"
                                             Checked="Source_Checked" />
                                <RadioButton x:Name="SourceApp" Content="手机麦克风" Tag="app"
                                             GroupName="LiveSource" Style="{StaticResource LiveRoleTab}"
                                             Checked="Source_Checked" />
                                <RadioButton x:Name="SourceComputer" Content="电脑音频" Tag="computer"
                                             GroupName="LiveSource" Style="{StaticResource LiveRoleTab}"
                                             Checked="Source_Checked" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="MonitorButton" Content="开启扬声器监听"
                                        Style="{StaticResource GrayButton}" Padding="14,7"
                                        Click="Monitor_Click" ToolTip="在本机扬声器播放当前音源" />
                                <TextBlock x:Name="MonitorStateText" Text="监听未开启" Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 设备 -->
                    <Border Style="{StaticResource FlatCardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="设备" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                                <Button Content="刷新设备" Style="{StaticResource SmallGrayButton}"
                                        DockPanel.Dock="Right" HorizontalAlignment="Right"
                                        Click="RefreshDevices_Click" ToolTip="授权并刷新摄像头 / 麦克风列表" />
                            </DockPanel>
                            <TextBlock Text="本机摄像头" Style="{StaticResource FieldLabelText}" />
                            <ComboBox x:Name="CameraCombo" SelectionChanged="CameraCombo_SelectionChanged"
                                      ToolTip="选择用于直播的摄像头" />
                            <CheckBox x:Name="CameraEnabledCheck" Content="开启摄像头（关闭后只推音频）"
                                      IsChecked="True" Margin="0,10,0,0"
                                      Checked="CameraEnabled_Changed" Unchecked="CameraEnabled_Changed" />
                            <TextBlock Text="本机麦克风" Style="{StaticResource FieldLabelText}" Margin="0,12,0,6" />
                            <ComboBox x:Name="MicCombo" SelectionChanged="MicCombo_SelectionChanged"
                                      ToolTip="选择用于直播的麦克风" />
                        </StackPanel>
                    </Border>

                    <!-- 手机麦克风配对 -->
                    <Border Style="{StaticResource FlatCardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="手机麦克风配对" Style="{StaticResource LiveSectionTitle}" />
                            <Border Background="#F3F5F9" CornerRadius="10" Padding="10" HorizontalAlignment="Center">
                                <Image x:Name="QrImage" Width="150" Height="150" Stretch="Uniform"
                                       ToolTip="手机扫码后即可把手机麦克风接入直播" />
                            </Border>
                            <TextBlock x:Name="PairStateText" Text="等待扫码配对" Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center" Margin="0,8,0,4" />
                            <TextBlock x:Name="TokenText" Text="配对令牌：—" Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="RefreshTokenButton" Content="重新生成" Style="{StaticResource SmallGrayButton}"
                                        Margin="0,0,8,6" Click="RefreshToken_Click" IsEnabled="False" />
                                <Button x:Name="CopyPairButton" Content="复制配对链接" Style="{StaticResource SmallGrayButton}"
                                        Margin="0,0,8,6" Click="CopyPair_Click" IsEnabled="False" />
                                <Button x:Name="KickAppButton" Content="断开手机" Style="{StaticResource SmallGrayButton}"
                                        Margin="0,0,8,6" Click="KickApp_Click" Visibility="Collapsed" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 观众观看 -->
                    <Border Style="{StaticResource FlatCardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="观众观看" Style="{StaticResource LiveSectionTitle}" Margin="0" VerticalAlignment="Center" />
                                <TextBlock x:Name="ViewerCountBadge" Text="0 人" Style="{StaticResource MutedText}"
                                           DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock x:Name="ViewerLinkText" Text="观看链接：生成中…" Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap" />
                            <Button x:Name="CopyViewerButton" Content="复制观看链接" Style="{StaticResource SmallGrayButton}"
                                    Margin="0,10,0,0" HorizontalAlignment="Left" Click="CopyViewer_Click" />
                        </StackPanel>
                    </Border>

                    <!-- 连接状态 -->
                    <Border Style="{StaticResource FlatCardBorder}">
                        <StackPanel>
                            <TextBlock Text="连接状态" Style="{StaticResource LiveSectionTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="频道" Style="{StaticResource MutedText}" Margin="0,0,12,6" />
                                <TextBlock x:Name="StateChannelText" Grid.Row="0" Grid.Column="1" Text="频道 1"
                                           Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="1" Text="信令服务器" Style="{StaticResource MutedText}" Margin="0,0,12,6" />
                                <TextBlock x:Name="StateSignalText" Grid.Row="1" Grid.Column="1" Text="连接中"
                                           Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="2" Text="手机端" Style="{StaticResource MutedText}" Margin="0,0,12,6" />
                                <TextBlock x:Name="StateAppText" Grid.Row="2" Grid.Column="1" Text="未连接"
                                           Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="3" Text="手机 P2P" Style="{StaticResource MutedText}" Margin="0,0,12,6" />
                                <TextBlock x:Name="StatePeerText" Grid.Row="3" Grid.Column="1" Text="未建立"
                                           Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="4" Text="当前音源" Style="{StaticResource MutedText}" Margin="0,0,12,6" />
                                <TextBlock x:Name="StateSourceText" Grid.Row="4" Grid.Column="1" Text="本机麦克风"
                                           Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="5" Text="观看人数" Style="{StaticResource MutedText}" Margin="0,0,12,0" />
                                <TextBlock x:Name="StateViewersText" Grid.Row="5" Grid.Column="1" Text="0 人"
                                           Style="{StaticResource MutedText}" FontWeight="SemiBold" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
