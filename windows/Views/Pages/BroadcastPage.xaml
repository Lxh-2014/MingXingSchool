<UserControl x:Class="MingxingSchool.Desktop.Views.Pages.BroadcastPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>

        <!-- 左：频道实时状态 -->
        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="20">
            <StackPanel>
                <TextBlock Text="频道实时状态" Style="{StaticResource CardTitleText}" />
                <TextBlock Text="状态通过 SSE 实时同步，每次播放 / 暂停都会自动刷新"
                           Style="{StaticResource MutedText}" Margin="0,6,0,16" />
                <ItemsControl x:Name="ChannelList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardAltBrush}" CornerRadius="12" Padding="14"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="12" VerticalAlignment="Center">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding IconColor}" />
                                        </Border.Background>
                                        <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="18"
                                                   FontWeight="Bold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextTitleBrush}" />
                                        <TextBlock Text="{Binding AudioDesc}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border CornerRadius="20" Padding="10,3" HorizontalAlignment="Right">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding StatusColor}" />
                                            </Border.Background>
                                            <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11.5" />
                                        </Border>
                                        <TextBlock Text="{Binding ListenersDesc}" FontSize="11.5" Margin="0,6,0,0"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 右：广播控制台 -->
        <Border x:Name="ControlPanel" Grid.Column="2" Style="{StaticResource CardBorder}" Padding="20"
                VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="广播控制台" Style="{StaticResource CardTitleText}" />
                <TextBlock Text="选择频道与音频，控制投放到各教室的播放内容"
                           Style="{StaticResource MutedText}" Margin="0,6,0,0" />

                <TextBlock Text="频道" Style="{StaticResource FieldLabelText}" Margin="0,18,0,6" />
                <ComboBox x:Name="ChannelCombo" MinHeight="38" DisplayMemberPath="Name" />

                <TextBlock Text="音频" Style="{StaticResource FieldLabelText}" Margin="0,14,0,6" />
                <ComboBox x:Name="AudioCombo" MinHeight="38" DisplayMemberPath="Name" />

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="播放" Style="{StaticResource PrimaryButton}" Grid.Column="0" Click="Play_Click" />
                    <Button Content="停止" Style="{StaticResource DangerButton}" Grid.Column="2" Click="Stop_Click" />
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="暂停" Style="{StaticResource GrayButton}" Grid.Column="0" Click="Pause_Click" />
                    <Button Content="继续" Style="{StaticResource GreenButton}" Grid.Column="2" Click="Resume_Click" />
                </Grid>

                <Button Content="刷新状态" Style="{StaticResource GhostButton}" HorizontalAlignment="Center"
                        Margin="0,16,0,0" Click="Refresh_Click" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>