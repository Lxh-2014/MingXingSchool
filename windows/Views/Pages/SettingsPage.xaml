<UserControl x:Class="MingxingSchool.Desktop.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="设置" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="管理账号邮箱、修改密码与外观偏好" Style="{StaticResource MutedText}" Margin="0,6,0,0" />

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- 账号 -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="账号与通知" Style="{StaticResource CardTitleText}" />

                        <TextBlock Text="绑定邮箱" Style="{StaticResource SectionTitleText}" Margin="0,20,0,0" />
                        <TextBlock Text="绑定后，管理员可向你发送纪律告知等通知邮件"
                                   Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                        <Border Background="{DynamicResource CardAltBrush}" CornerRadius="10" Padding="12,10"
                                Margin="0,12,0,0">
                            <TextBlock x:Name="EmailText" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                        </Border>
                        <Button Content="绑定 / 修改邮箱" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left" Margin="0,10,0,0" Click="BindEmail_Click" />

                        <TextBlock Text="登录密码" Style="{StaticResource SectionTitleText}" Margin="0,24,0,0" />
                        <TextBlock Text="修改需验证当前密码" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                        <Button Content="修改密码" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left" Margin="0,10,0,0" Click="ChangePwd_Click" />
                    </StackPanel>
                </Border>

                <!-- 外观与关于 -->
                <Border Grid.Column="2" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="外观" Style="{StaticResource CardTitleText}" />
                        <CheckBox x:Name="DarkBox" Content="深色模式" Margin="0,16,0,0"
                                  Checked="DarkBox_Changed" Unchecked="DarkBox_Changed" />

                        <TextBlock Text="关于" Style="{StaticResource SectionTitleText}" Margin="0,28,0,0" />
                        <TextBlock Text="明星学校桌面客户端" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                        <TextBlock Text="版本 1.0.0" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                        <TextBlock x:Name="ServerText" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>