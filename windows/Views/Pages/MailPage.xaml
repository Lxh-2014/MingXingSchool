<UserControl x:Class="MingxingSchool.Desktop.Views.Pages.MailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- 左：发送处罚邮件 -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="发送处罚邮件" Style="{StaticResource CardTitleText}" />
                    <TextBlock Text="选择已绑定邮箱的学生，填写违纪信息后发送纪律告知邮件"
                               Style="{StaticResource MutedText}" Margin="0,8,0,0" />

                    <TextBlock Text="学生" Style="{StaticResource FieldLabelText}" Margin="0,20,0,6" />
                    <ComboBox x:Name="StudentCombo" MinHeight="38">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding Name}" FontWeight="SemiBold" /><Run Text="  |  " /><Run Text="{Binding Email}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="违纪日期" Style="{StaticResource FieldLabelText}" Margin="0,14,0,6" />
                    <DatePicker x:Name="DateBox" />

                    <TextBlock Text="违纪原因（如：上课使用手机）" Style="{StaticResource FieldLabelText}" Margin="0,14,0,6" />
                    <TextBox x:Name="ReasonBox" MinHeight="38" />

                    <TextBlock Text="处理决定（每行一条）" Style="{StaticResource FieldLabelText}" Margin="0,14,0,6" />
                    <TextBox x:Name="PunishBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="年级（可选）" Style="{StaticResource FieldLabelText}" />
                            <TextBox x:Name="GradeBox" MinHeight="38" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="班级（可选）" Style="{StaticResource FieldLabelText}" />
                            <TextBox x:Name="ClassBox" MinHeight="38" />
                        </StackPanel>
                    </Grid>

                    <Button x:Name="SendButton" Content="发送处罚邮件" Style="{StaticResource DangerButton}"
                            Margin="0,22,0,0" Height="44" Click="Send_Click" />
                </StackPanel>
            </Border>

            <!-- 右：邮件服务器配置 -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="邮件服务器配置" Style="{StaticResource CardTitleText}" />
                    <TextBlock Text="发邮件前需先配置 SMTP 服务器与授权码" Style="{StaticResource MutedText}"
                               Margin="0,8,0,0" />

                    <TextBlock Text="SMTP 服务器（如 smtp.qq.com）" Style="{StaticResource FieldLabelText}" Margin="0,20,0,6" />
                    <TextBox x:Name="HostBox" MinHeight="38" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="端口" Style="{StaticResource FieldLabelText}" />
                            <TextBox x:Name="PortBox" MinHeight="38" />
                        </StackPanel>
                        <CheckBox x:Name="SecureBox" Grid.Column="2" Content="使用 SSL/TLS"
                                  VerticalAlignment="Bottom" Margin="0,0,0,10" />
                    </Grid>

                    <TextBlock Text="发送邮箱账号（如 123456@qq.com）" Style="{StaticResource FieldLabelText}" Margin="0,14,0,6" />
                    <TextBox x:Name="UserBox" MinHeight="38" />

                    <TextBlock Text="邮箱授权码" Style="{StaticResource FieldLabelText}" Margin="0,14,0,6" />
                    <PasswordBox x:Name="PassBox" MinHeight="38" />

                    <TextBlock Text="发件人显示名（如 明星学校）" Style="{StaticResource FieldLabelText}" Margin="0,14,0,6" />
                    <TextBox x:Name="FromNameBox" MinHeight="38" />

                    <TextBlock Text="发件人地址（留空默认同账号）" Style="{StaticResource FieldLabelText}" Margin="0,14,0,6" />
                    <TextBox x:Name="FromAddressBox" MinHeight="38" />

                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="发送测试邮件" Style="{StaticResource GhostButton}" Grid.Column="0"
                                Click="Test_Click" Height="40" />
                        <Button Content="保存配置" Style="{StaticResource PrimaryButton}" Grid.Column="2"
                                Click="SaveConfig_Click" Height="40" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>