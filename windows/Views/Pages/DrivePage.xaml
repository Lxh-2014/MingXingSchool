<UserControl x:Class="MingxingSchool.Desktop.Views.Pages.DrivePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 地址栏内的小方形导航按钮（后退/前进/上级/刷新），对齐网页端 28x28 圆角 4 -->
        <Style x:Key="NavIconButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 面包屑路径段：无边框文字按钮，悬停浅灰底 -->
        <Style x:Key="BreadcrumbButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="4,2">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 右键菜单条目：圆角、悬停浅灰 -->
        <Style x:Key="MenuItemStyle" TargetType="MenuItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="25" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ 工具栏：左侧地址栏（导航+面包屑+搜索），右侧操作按钮 ============ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20" LastChildFill="True">
            <!-- 右侧：上传 / 新建文件夹 -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button Style="{StaticResource PrimaryButton}" Click="Upload_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15" VerticalAlignment="Center" />
                        <TextBlock Text="上传文件" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GrayButton}" Margin="10,0,0,0" Click="NewFolder_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15" VerticalAlignment="Center" />
                        <TextBlock Text="创建新文件夹" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 地址栏：白底圆角卡片，内含导航按钮 + 面包屑 + 搜索框 -->
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="8,6" VerticalAlignment="Center">
                <DockPanel LastChildFill="True">
                    <!-- 导航按钮组 -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BackButton" Style="{StaticResource NavIconButton}" ToolTip="后退"
                                Content="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="13" Click="Back_Click" />
                        <Button x:Name="ForwardButton" Style="{StaticResource NavIconButton}" ToolTip="前进"
                                Content="&#xE72A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="13" Click="Forward_Click" />
                        <Button x:Name="UpButton" Style="{StaticResource NavIconButton}" ToolTip="上级目录"
                                Content="&#xE74A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="13" Click="GoUp_Click" />
                        <Button Style="{StaticResource NavIconButton}" ToolTip="刷新"
                                Content="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="13" Click="Refresh_Click" />
                    </StackPanel>

                    <!-- 搜索框：半透明浅灰底，实时过滤当前目录 -->
                    <Border DockPanel.Dock="Right" Background="#0A000000" CornerRadius="6"
                            Padding="8,5" MinWidth="200" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="14" Height="14" Margin="0,0,6,0"
                                  VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Stroke="{DynamicResource TextSecondaryBrush}"
                                         StrokeThickness="1.6" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <Line X1="0" Y1="0" X2="4" Y2="4" Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.6" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Grid>
                            <Grid Grid.Column="1">
                                <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                                         FontSize="13" VerticalContentAlignment="Center"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         TextChanged="Search_TextChanged" />
                                <!-- 占位提示：搜索框为空时显示，不拦截鼠标事件 -->
                                <TextBlock Text="在此处搜索..." FontSize="13" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Margin="0,1,0,0"
                                           Foreground="{DynamicResource InputPlaceholderBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 面包屑：可点击的路径段，末段为当前目录 -->
                    <ItemsControl x:Name="BreadcrumbList" VerticalAlignment="Center" Margin="10,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding Name}" Style="{StaticResource BreadcrumbButton}"
                                            Tag="{Binding}" Click="Breadcrumb_Click" />
                                    <TextBlock Text="/" Margin="2,0" VerticalAlignment="Center"
                                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="{Binding SeparatorVisibility}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </DockPanel>

        <!-- ============ 文件网格 / 空状态 ============ -->
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="FileGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- 文件卡片：白底圆角 12，悬停浮起 + 蓝边 -->
                            <Border x:Name="Card" Width="150" MinHeight="142" Margin="0,0,20,20"
                                    Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="15"
                                    BorderThickness="1" BorderBrush="Transparent" Cursor="Hand"
                                    MouseLeftButtonDown="FileCard_MouseLeftButtonDown"
                                    MouseRightButtonDown="FileCard_MouseRightButtonDown">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Style="{StaticResource MenuItemStyle}" Header="下载 / 导出"
                                                  Click="MenuDownload_Click" />
                                        <MenuItem Style="{StaticResource MenuItemStyle}" Header="重命名"
                                                  Click="MenuRename_Click" />
                                        <MenuItem Style="{StaticResource MenuItemStyle}" Header="属性"
                                                  Click="MenuInfo_Click" />
                                        <MenuItem Style="{StaticResource MenuItemStyle}" Header="删除"
                                                  Foreground="{DynamicResource DangerBrush}"
                                                  Click="MenuDelete_Click" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel VerticalAlignment="Center">
                                    <Grid Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,12">
                                        <Path Data="{Binding IconGeometry}" Fill="{Binding IconBrush}"
                                              Stretch="Uniform" Width="52" Height="52" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="14"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextAlignment="Center" TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis" MaxHeight="40"
                                               LineHeight="18" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush"
                                            Value="{DynamicResource PrimaryBrush}" />
                                    <Setter TargetName="Card" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="Black" BlurRadius="12"
                                                              ShadowDepth="2" Direction="270" Opacity="0.15" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空状态：大图标 + 提示文字 -->
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed">
                <Path Data="M22,19 A2,2 0 0,1 20,21 H4 A2,2 0 0,1 2,19 V5 A2,2 0 0,1 4,3 H9 L11,6 H20 A2,2 0 0,1 22,8 Z"
                      Fill="{DynamicResource TextSecondaryBrush}" Opacity="0.45" Stretch="Uniform"
                      Width="80" Height="80" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyText" Text="没有文件" Margin="0,20,0,0" FontSize="14"
                           HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- 加载提示 -->
            <TextBlock x:Name="LoadingText" Text="加载中…" HorizontalAlignment="Center"
                       VerticalAlignment="Center" FontSize="14" Visibility="Collapsed"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </Grid>
    </Grid>
</UserControl>
