<UserControl x:Class="MingxingSchool.Desktop.Views.Pages.UsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button Content="＋ 新建用户" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right"
                    VerticalAlignment="Center" Click="Create_Click" />
            <StackPanel>
                <TextBlock Text="用户管理" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="创建账号、重置学号、调整角色或删除用户" Style="{StaticResource MutedText}"
                           Margin="0,6,0,0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="8">
            <DataGrid x:Name="UserGrid" AutoGenerateColumns="False" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="用户" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="14"
                                            Background="{DynamicResource PrimaryBrush}">
                                        <TextBlock Text="{Binding AvatarText}" Foreground="White" FontSize="12"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="1*" />
                    <DataGridTextColumn Header="积分" Binding="{Binding Points}" Width="100" />
                    <DataGridTextColumn Header="邮箱" Binding="{Binding Email}" Width="1.4*" />
                    <DataGridTemplateColumn Header="角色" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="20" Padding="10,3" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAdminRow}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding RoleText}" FontSize="11.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAdminRow}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="操作" Width="430">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <WrapPanel>
                                    <Button Content="重置学号" Style="{StaticResource SmallGrayButton}" Margin="0,0,6,2" Click="ResetPwd_Click" />
                                    <Button Content="重命名" Style="{StaticResource SmallGrayButton}" Margin="0,0,6,2" Click="Rename_Click" />
                                    <Button Content="积分" Style="{StaticResource SmallGrayButton}" Margin="0,0,6,2" Click="Points_Click" />
                                    <Button Content="邮箱" Style="{StaticResource SmallGrayButton}" Margin="0,0,6,2" Click="BindMail_Click" />
                                    <Button Content="改ID" Style="{StaticResource SmallGrayButton}" Margin="0,0,6,2"
                                            Visibility="{Binding IsAdminRow, Converter={StaticResource InverseBoolToVis}}" Click="ChangeId_Click" />
                                    <Button Content="权限" Style="{StaticResource SmallGrayButton}" Margin="0,0,6,2"
                                            Visibility="{Binding IsAdminRow, Converter={StaticResource InverseBoolToVis}}" Click="ChangeRole_Click" />
                                    <Button Content="删除" Style="{StaticResource DangerButton}" FontSize="11.5"
                                            Padding="10,4" Margin="0,0,6,2"
                                            Visibility="{Binding IsAdminRow, Converter={StaticResource InverseBoolToVis}}" Click="Delete_Click" />
                                </WrapPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>