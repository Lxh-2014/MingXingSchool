<Window x:Class="MingxingSchool.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="明星学校" Width="1200" Height="760" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource PageBackgroundBrush}"
        FontFamily="{DynamicResource UiFont}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <!-- 无边框自定义窗口：保留系统缩放边框与 Aero Snap，标题栏由页面自绘 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="{DynamicResource PageBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="72" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧图标导航栏 -->
            <Border x:Name="SidebarBar" Grid.RowSpan="3" Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel>
                    <!-- 侧边栏 Logo：使用平台正式 logo -->
                    <Border Width="44" Height="44" CornerRadius="12" ClipToBounds="True"
                            Margin="0,16,0,18" HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/Home/logo.png" Stretch="UniformToFill" />
                    </Border>

                    <!-- 导航项与网页端主项目侧边栏完全一致：首页 / 设置 / 用户管理（管理员）/ 邮件（管理员） -->
                    <RadioButton x:Name="NavHome" Style="{StaticResource NavRadio}" Content="&#xE80F;"
                                 ToolTip="首页" GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavRadio}" Content="&#xE713;"
                                 ToolTip="设置" GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavUsers" Style="{StaticResource NavRadio}" Content="&#xE716;"
                                 ToolTip="用户管理" GroupName="Nav" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavMail" Style="{StaticResource NavRadio}" Content="&#xE715;"
                                 ToolTip="邮件" GroupName="Nav" Checked="Nav_Checked" />
                </StackPanel>
            </Border>

            <!-- 顶部栏：整条为可拖动标题栏，右侧为自绘窗口控制按钮 -->
            <Border x:Name="TopbarBar" Grid.Row="0" Grid.Column="1" Height="46" Background="{DynamicResource TopbarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <!-- 头像：可点击，弹出账号菜单（含积分与退出登录） -->
                        <Button x:Name="AvatarButton" Width="36" Height="36" Cursor="Hand"
                                Click="Avatar_Click" Background="Transparent" BorderThickness="0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="18"
                                            Background="{DynamicResource HoverBrush}" ClipToBounds="True">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid Width="36" Height="36">
                                <Image x:Name="AvatarImage" Stretch="UniformToFill" />
                                <TextBlock x:Name="AvatarInitial" FontSize="15" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>
                        </Button>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="UserNameText" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTitleBrush}" />
                            <TextBlock x:Name="UserPointsText" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>

                        <!-- 窗口控制按钮组 -->
                        <Border Width="1" Height="18" Background="{DynamicResource BorderBrush}"
                                Margin="12,0,6,0" />
                        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;"
                                Click="Minimize_Click" ToolTip="最小化"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                                Click="Maximize_Click" ToolTip="最大化"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;"
                                Click="Close_Click" ToolTip="关闭"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                    </StackPanel>

                    <!-- 空白区域留作窗口拖动 -->
                    <TextBlock Text="" />
                </DockPanel>
            </Border>

            <!-- 标签栏：浏览器式多标签，右侧“+”新建首页标签 -->
            <Border x:Name="TabbarBar" Grid.Row="1" Grid.Column="1" Height="42" Background="{DynamicResource TopbarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,5">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <ItemsControl x:Name="TabStrip">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,4,0">
                                        <!-- 标签卡片：点击切换，选中态高亮 -->
                                        <Border x:Name="TabCard" Height="32" MinWidth="130" MaxWidth="220" CornerRadius="8"
                                                Background="Transparent" Cursor="Hand" Padding="12,0,34,0"
                                                MouseLeftButtonDown="Tab_Click">
                                            <TextBlock x:Name="TabTitle" Text="{Binding Title}" FontSize="12.5"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                        <!-- 关闭按钮：叠放在标签右侧 -->
                                        <Button Style="{StaticResource CaptionButton}" Width="24" Height="24"
                                                Content="&#xE8BB;" FontSize="9"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Margin="0,0,6,0" ToolTip="关闭标签" Click="CloseTab_Click" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="TabCard" Property="Background"
                                                    Value="{DynamicResource CardBrush}" />
                                            <Setter TargetName="TabTitle" Property="Foreground"
                                                    Value="{DynamicResource TextTitleBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 新建标签页按钮 -->
                        <Button x:Name="NewTabButton" Style="{StaticResource CaptionButton}" Width="32" Height="32"
                                Content="&#xE710;" FontSize="15" ToolTip="新建标签页" Click="NewTab_Click" Margin="2,0,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 内容区 -->
            <ContentControl x:Name="ContentHost" Grid.Row="2" Grid.Column="1" />

            <!-- 轻提示容器（右上角） -->
            <StackPanel x:Name="ToastHost" Grid.Column="1" Grid.RowSpan="3" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="0,96,20,0" />

            <!-- 账号菜单：点击头像弹出（结构对齐网页端：头像+姓名/ID → 积分 → 分割线 → 退出登录） -->
            <Popup x:Name="AvatarMenu" PlacementTarget="{Binding ElementName=AvatarButton}"
                   Placement="Bottom" HorizontalOffset="-204" VerticalOffset="8"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Width="240" Background="{DynamicResource TopbarBrush}" CornerRadius="12"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="4"
                                          Direction="270" Opacity="0.16" />
                    </Border.Effect>
                    <StackPanel>
                        <!-- 上段：头像 + 姓名 / ID -->
                        <Grid Margin="8,8,8,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="20"
                                    Background="{DynamicResource HoverBrush}" ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="MenuAvatarImage" Stretch="UniformToFill" />
                                    <TextBlock x:Name="MenuAvatarInitial" FontSize="16" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="MenuNameText" FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextTitleBrush}" />
                                <TextBlock x:Name="MenuIdText" FontSize="11.5" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <!-- 积分行：金色星币 + 纯数字 -->
                        <Border Background="{DynamicResource CardAltBrush}" CornerRadius="8"
                                Padding="10,9" Margin="4,0,4,4">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="16" Height="16" VerticalAlignment="Center">
                                    <Ellipse Width="16" Height="16" Fill="#F5B301" />
                                    <Path Fill="White"
                                          Data="M 8 3 L 9.6 6.6 L 13 6.9 L 10.4 9.3 L 11.2 12.7 L 8 10.8 L 4.8 12.7 L 5.6 9.3 L 3 6.9 L 6.4 6.6 Z" />
                                </Grid>
                                <TextBlock x:Name="MenuPointsText" Margin="8,0,0,0" FontSize="13"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="6,4" />

                        <!-- 退出登录 -->
                        <Button Click="MenuLogout_Click" Cursor="Hand" Background="Transparent"
                                HorizontalContentAlignment="Left">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ItemBody" Background="{TemplateBinding Background}"
                                            CornerRadius="8" Padding="10,9">
                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBody" Property="Background"
                                                    Value="{DynamicResource HoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="14" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="退出登录" Margin="8,0,0,0" FontSize="13"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
