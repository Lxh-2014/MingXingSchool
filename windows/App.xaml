<Application x:Class="MingxingSchool.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MingxingSchool.Desktop.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 初始主题（运行时由 ThemeManager 整体替换为 Dark.xaml） -->
                <ResourceDictionary Source="Themes/Light.xaml" />
                <!-- 全局控件样式（按钮、输入框、表格、导航等） -->
                <ResourceDictionary Source="Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 全局值转换器 -->
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
            <conv:NullToVisibilityConverter x:Key="NullToVis" />
            <conv:ImageUrlConverter x:Key="ImageUrl" />
            <conv:StatusToBrushConverter x:Key="StatusToBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>