<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 明亮主题色板（与 docs/UI设计规范.md 的浅色变量保持一致） -->
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F5F7FA" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardAltBrush" Color="#FAFBFD" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TopbarBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E1E5EB" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#333333" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#666666" />
    <SolidColorBrush x:Key="TextTitleBrush" Color="#222222" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#4A90E2" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#3A7BC8" />
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#EBF5FF" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputPlaceholderBrush" Color="#999999" />
    <SolidColorBrush x:Key="HoverBrush" Color="#F0F3F8" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EE0000" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FFF1F0" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#27AE60" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E6A700" />
    <SolidColorBrush x:Key="InfoBrush" Color="#3498DB" />
    <SolidColorBrush x:Key="ToastBackgroundBrush" Color="#FFFFFF" />

    <!-- 多邻国风格按钮（颜色取自 docs/按钮.html，不随主题变化）：背景 + 底部 4px 阴影 + 悬停态 -->
    <SolidColorBrush x:Key="ButtonBlueBrush" Color="#1CB0F6" />
    <SolidColorBrush x:Key="ButtonBlueShadowBrush" Color="#1899D6" />
    <SolidColorBrush x:Key="ButtonBlueHoverBrush" Color="#1FC2FF" />
    <SolidColorBrush x:Key="ButtonBlueHoverShadowBrush" Color="#1AA8EB" />
    <SolidColorBrush x:Key="ButtonGreenBrush" Color="#3CB371" />
    <SolidColorBrush x:Key="ButtonGreenShadowBrush" Color="#267A4A" />
    <SolidColorBrush x:Key="ButtonGreenHoverBrush" Color="#50C878" />
    <SolidColorBrush x:Key="ButtonGreenHoverShadowBrush" Color="#2E8B57" />
    <SolidColorBrush x:Key="ButtonRedBrush" Color="#EE0000" />
    <SolidColorBrush x:Key="ButtonRedShadowBrush" Color="#BC0000" />
    <SolidColorBrush x:Key="ButtonRedHoverBrush" Color="#FF3F3F" />
    <SolidColorBrush x:Key="ButtonRedHoverShadowBrush" Color="#DE0000" />
    <SolidColorBrush x:Key="ButtonPinkBrush" Color="#FF7BAC" />
    <SolidColorBrush x:Key="ButtonPinkShadowBrush" Color="#C94A83" />
    <SolidColorBrush x:Key="ButtonPinkHoverBrush" Color="#FF84AF" />
    <SolidColorBrush x:Key="ButtonPinkHoverShadowBrush" Color="#C25487" />
    <SolidColorBrush x:Key="ButtonGrayBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="ButtonGrayShadowBrush" Color="#B4B4B4" />
    <SolidColorBrush x:Key="ButtonGrayHoverBrush" Color="#EBEBEB" />
    <SolidColorBrush x:Key="ButtonGrayHoverShadowBrush" Color="#C8C8C8" />
    <SolidColorBrush x:Key="ButtonGrayTextBrush" Color="#3C3C3C" />

    <Color x:Key="ShadowColor">#22000000</Color>
    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI</FontFamily>
</ResourceDictionary>
