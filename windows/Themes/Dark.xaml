<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色主题色板：键名与 Light.xaml 完全一致，便于运行时整体替换 -->
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#17181A" />
    <SolidColorBrush x:Key="CardBrush" Color="#1A1B1F" />
    <SolidColorBrush x:Key="CardAltBrush" Color="#1D1D1D" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#1A1B1F" />
    <SolidColorBrush x:Key="TopbarBrush" Color="#1A1B1F" />
    <SolidColorBrush x:Key="BorderBrush" Color="#242424" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EAEAEA" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B8B8B8" />
    <SolidColorBrush x:Key="TextTitleBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#5AA6F0" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#4A90E2" />
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#1D1D1D" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1D1D1D" />
    <SolidColorBrush x:Key="InputPlaceholderBrush" Color="#888888" />
    <SolidColorBrush x:Key="HoverBrush" Color="#242424" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#2A1B1B" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#51CF66" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFD43B" />
    <SolidColorBrush x:Key="InfoBrush" Color="#339AF0" />
    <SolidColorBrush x:Key="ToastBackgroundBrush" Color="#242424" />

    <!-- 多邻国风格按钮（颜色取自 docs/按钮.html，深色模式下同样不变化） -->
    <SolidColorBrush x:Key="ButtonBlueBrush" Color="#1CB0F6" />
    <SolidColorBrush x:Key="ButtonBlueShadowBrush" Color="#1899D6" />
    <SolidColorBrush x:Key="ButtonBlueHoverBrush" Color="#1FC2FF" />
    <SolidColorBrush x:Key="ButtonBlueHoverShadowBrush" Color="#1AA8EB" />
    <SolidColorBrush x:Key="ButtonGreenBrush" Color="#3CB371" />
    <SolidColorBrush x:Key="ButtonGreenShadowBrush" Color="#267A4A" />
    <SolidColorBrush x:Key="ButtonGreenHoverBrush" Color="#50C878" />
    <SolidColorBrush x:Key="ButtonGreenHoverShadowBrush" Color="#2E8B57" />
    <SolidColorBrush x:Key="ButtonRedBrush" Color="#EE0000" />
    <SolidColorBrush x:Key="ButtonRedShadowBrush" Color="#BC0000" />
    <SolidColorBrush x:Key="ButtonRedHoverBrush" Color="#FF3F3F" />
    <SolidColorBrush x:Key="ButtonRedHoverShadowBrush" Color="#DE0000" />
    <SolidColorBrush x:Key="ButtonPinkBrush" Color="#FF7BAC" />
    <SolidColorBrush x:Key="ButtonPinkShadowBrush" Color="#C94A83" />
    <SolidColorBrush x:Key="ButtonPinkHoverBrush" Color="#FF84AF" />
    <SolidColorBrush x:Key="ButtonPinkHoverShadowBrush" Color="#C25487" />
    <SolidColorBrush x:Key="ButtonGrayBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="ButtonGrayShadowBrush" Color="#B4B4B4" />
    <SolidColorBrush x:Key="ButtonGrayHoverBrush" Color="#EBEBEB" />
    <SolidColorBrush x:Key="ButtonGrayHoverShadowBrush" Color="#C8C8C8" />
    <SolidColorBrush x:Key="ButtonGrayTextBrush" Color="#3C3C3C" />

    <Color x:Key="ShadowColor">#66000000</Color>
    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI</FontFamily>
</ResourceDictionary>
