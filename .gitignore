!.env.example
*.pem
*.key
*.crt
*.pfx

# ---------- 文档与证书目录（含 HTTPS 私钥，禁止提交） ----------
docs/

# ---------- 打包发布产物（apk / exe 安装包） ----------
application/

# ---------- 运行时数据（含用户信息、邮件账号等敏感配置） ----------
server/data/
!server/data/.gitkeep

# ---------- 网盘应用的用户上传文件（体积达数 GB，不纳入版本管理） ----------
apps/drive/files/

# ---------- 日志 ----------
*.log
logs/
debug.log

# ---------- 临时与缓存 ----------
.tmp/
.temp/
.trae/tmp/
.screenshots/

