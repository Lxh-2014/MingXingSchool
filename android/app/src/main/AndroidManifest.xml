<?xml version="1.0" encoding="utf-8"?>
<!-- 应用清单：声明网络权限、应用主题、登录页与主页 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 邻语文件下载：Android 10 以下保存到公共下载目录需要写外部存储权限 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- 访问后端接口所需的网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 音频后台播放的前台服务与媒体播放类型（Android 14 起必须声明） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 邻语消息提醒：后台轮询需要特殊用途前台服务（Android 14 起必须声明） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 通知栏媒体卡片展示（Android 13 起需运行时授权） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 直播：手动开启摄像头预览，原生 WebRTC 不自带该权限 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 直播：手机端推流需要录音 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 直播：切换扬声器/通话音量模式 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 直播：保持屏幕常亮，避免观看中息屏断流 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 直播：WebRTC 的 AndroidNetworkMonitor 需要读取网络状态来生成 ICE 候选；
         缺少该权限时 registerNetworkCallback 会在 network_thread 上抛 SecurityException，
         被 WebRTC 的 CHECK_EXCEPTION 判定为致命错误后直接 abort（无 Java 堆栈的原生崩溃） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".MingXingApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MingxingSchool">

        <!-- 启动页：登录页，导出以便系统启动器拉起 -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 主页：登录成功后的落地页，仅应用内部跳转，不导出 -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- 明星广播器：控制台 + 频道收听页，仅应用内部跳转，不导出 -->
        <activity
            android:name=".broadcast.BroadcastActivity"
            android:exported="false" />

        <!-- 明星商店：店铺、商品、购物车、订单，仅应用内部跳转，不导出 -->
        <activity
            android:name=".shop.ShopActivity"
            android:exported="false" />

        <!-- 广播音频播放服务：后台/息屏持续播放 + 系统媒体卡片，仅应用内部启动，不导出 -->
        <service
            android:name=".broadcast.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- 明星直播：原生 WebRTC 观看频道 + 手机端推流 -->
        <activity
            android:name=".live.LiveActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 邻语：WebView 承载 H5 页面（会话列表 / 聊天 / 群设置 / 邀请） -->
        <activity
            android:name=".im.ImActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <!-- 邻语消息提醒：后台定时轮询会话，有新消息时在通知栏提醒 -->
        <service
            android:name=".im.ImMessageService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="im_message_polling" />
        </service>

        <!-- 扫码配对页（ZXing 库自带页面）：覆盖库默认的横屏，改为竖屏更便于对准二维码 -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:replace="android:screenOrientation" />
    </application>
</manifest>
