<?xml version="1.0" encoding="utf-8"?>
<!-- 浅色模式色板：取自 public/assets/all.css 的登录页变量，保证与网页端一致 -->
<resources>
    <!-- 主色：标题、输入框聚焦边框 -->
    <color name="mx_primary">#4A90E2</color>
    <!-- 主色上的文字颜色 -->
    <color name="mx_on_primary">#FFFFFF</color>
    <!-- 主色浅容器色：用于次要强调区域 -->
    <color name="mx_primary_container">#D6E9FF</color>
    <!-- 主色浅容器上的文字颜色 -->
    <color name="mx_on_primary_container">#0B3D6B</color>

    <!-- 页面背景：登录页淡蓝色 -->
    <color name="mx_login_bg">#D8EAFF</color>
    <!-- 卡片/输入框表面色 -->
    <color name="mx_surface">#FFFFFF</color>
    <!-- 表面上的主要文字 -->
    <color name="mx_on_surface">#333333</color>
    <!-- 表面上的次要文字 -->
    <color name="mx_on_surface_variant">#666666</color>

    <!-- 输入框背景 -->
    <color name="mx_input_bg">#FFFFFF</color>
    <!-- 输入框未聚焦边框 -->
    <color name="mx_input_stroke">#E1E5EB</color>

    <!-- 错误提示文字颜色 -->
    <color name="mx_error">#E74C3C</color>

    <!-- Logo 方块背景色：取自校徽图 public/assets/home/logo.png 的底色 -->
    <color name="mx_logo_bg">#0066FF</color>

    <!-- 在线/已连接状态指示色（广播器连接圆点） -->
    <color name="mx_online">#2ECC71</color>

    <!-- 邻语：页面背景（浅灰，贴近 QQ 消息列表与聊天背景） -->
    <color name="im_bg">#F2F3F5</color>
    <!-- 邻语：主要文字（会话名、消息正文） -->
    <color name="im_text_primary">#1C1C1E</color>
    <!-- 邻语：次要文字（消息预览、群昵称、时间） -->
    <color name="im_text_secondary">#8A8F99</color>
    <!-- 邻语：未读角标红色 -->
    <color name="im_badge">#FF3B30</color>
</resources>
