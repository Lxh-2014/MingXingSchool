<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面框架：顶栏 + 内容区 + 底部导航栏
     顶栏右侧由代码填充头像与姓名；底部导航由代码填充（首页/设置/用户管理/邮件）；
     内容区按导航切换页面。根容器用 surface 色，使状态栏、顶栏、底部导航颜色一致。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mx_surface">

    <!-- 顶栏：左侧用户区（头像 + 姓名），点击弹出下拉菜单 -->
    <FrameLayout
        android:id="@+id/layout_topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/mx_surface">

        <LinearLayout
            android:id="@+id/layout_topbar_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />
    </FrameLayout>

    <!-- 内容区：页面内容切换处，使用淡蓝底与顶栏/导航栏区分 -->
    <FrameLayout
        android:id="@+id/layout_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/mx_login_bg" />

    <!-- 底部导航栏：图标 + 文字横向等分排列，由 MainActivity 代码填充
         外层负责手势条安全区（wrap_content + paddingBottom），内层固定 72dp -->
    <LinearLayout
        android:id="@+id/layout_nav_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/mx_surface">

        <LinearLayout
            android:id="@+id/layout_nav_items"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center" />
    </LinearLayout>
</LinearLayout>